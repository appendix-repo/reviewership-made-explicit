{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://reviewership.lakatos.example/schema/review-objects.v0.schema.json",
 "title": "Reviewership review objects (DRAFT v0.1)",
 "description": "Draft v0.1, 23 October 2026. Objects for the reviewing perspective, standards specification, scoreboard, simulated review, panel synthesis, probes and checks, consistency report, provenance events and consent records. Not yet implemented; used as the output format of the worked runs.",
 "$defs": {
  "Id": {
   "type": "string",
   "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
  },
  "Locus": {
   "type": "string",
   "description": "Section, equation, table cell or short quotation in the manuscript"
  },
  "DimensionSetting": {
   "type": "object",
   "required": [
    "weight",
    "parameters"
   ],
   "properties": {
    "weight": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "parameters": {
     "type": "object",
     "description": "Parameter code (e.g. ONT.3) to value: a string, an array of strings, or an object mapping options to preferred/admissible/suspect",
     "propertyNames": {
      "pattern": "^(ONT|EPI|INF|TEC|PRA)\\.[1-9]$"
     }
    }
   }
  },
  "Standard": {
   "type": "object",
   "required": [
    "@id",
    "dimension",
    "statement",
    "priority"
   ],
   "properties": {
    "@id": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "dimension": {
     "enum": [
      "ONT",
      "EPI",
      "INF",
      "TEC",
      "PRA"
     ]
    },
    "parameter": {
     "type": "string"
    },
    "statement": {
     "type": "string"
    },
    "priority": {
     "enum": [
      "must",
      "should",
      "could"
     ]
    },
    "origin": {
     "enum": [
      "reviewer",
      "suggested-accepted",
      "suggested-rewritten",
      "configured"
     ]
    },
    "reason": {
     "type": "string"
    }
   }
  },
  "ReviewingPerspective": {
   "type": "object",
   "required": [
    "@id",
    "@type",
    "label",
    "owner",
    "dimensions"
   ],
   "properties": {
    "@id": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "@type": {
     "const": "ReviewingPerspective"
    },
    "label": {
     "type": "string"
    },
    "owner": {
     "type": "object",
     "required": [
      "kind"
     ],
     "properties": {
      "kind": {
       "enum": [
        "human",
        "simulated",
        "stand-in"
       ]
      },
      "name": {
       "type": "string"
      }
     }
    },
    "dimensions": {
     "type": "object",
     "required": [
      "ONT",
      "EPI",
      "INF",
      "TEC",
      "PRA"
     ],
     "properties": {
      "ONT": {
       "$ref": "#/$defs/DimensionSetting"
      },
      "EPI": {
       "$ref": "#/$defs/DimensionSetting"
      },
      "INF": {
       "$ref": "#/$defs/DimensionSetting"
      },
      "TEC": {
       "$ref": "#/$defs/DimensionSetting"
      },
      "PRA": {
       "$ref": "#/$defs/DimensionSetting"
      }
     },
     "additionalProperties": false
    },
    "materialInferences": {
     "type": "object",
     "properties": {
      "endorsed": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "rejected": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    },
    "standards": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Standard"
     }
    },
    "corpus": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "relationToFocal": {
     "enum": [
      "focal",
      "resembling",
      "differing"
     ]
    }
   }
  },
  "EditorBrief": {
   "type": "object",
   "required": [
    "@id",
    "@type",
    "manuscript",
    "needs"
   ],
   "properties": {
    "@id": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "@type": {
     "const": "EditorBrief"
    },
    "manuscript": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "needs": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "concerns": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "audience": {
     "type": "string"
    },
    "round": {
     "type": "string"
    }
   }
  },
  "Tension": {
   "type": "object",
   "required": [
    "between"
   ],
   "properties": {
    "between": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
     }
    },
    "ranking": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
     }
    },
    "note": {
     "type": "string"
    }
   }
  },
  "StandardsSpecification": {
   "type": "object",
   "required": [
    "@id",
    "@type",
    "reviewer",
    "perspective",
    "editorBrief"
   ],
   "properties": {
    "@id": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "@type": {
     "const": "StandardsSpecification"
    },
    "reviewer": {
     "type": "string"
    },
    "perspective": {
     "$ref": "#/$defs/ReviewingPerspective"
    },
    "editorBrief": {
     "oneOf": [
      {
       "type": "string",
       "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
      },
      {
       "$ref": "#/$defs/EditorBrief"
      }
     ]
    },
    "tensions": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Tension"
     }
    },
    "isReview": {
     "const": false,
     "description": "A standards specification is never a review of the manuscript"
    }
   }
  },
  "ManuscriptRef": {
   "type": "object",
   "required": [
    "@id",
    "@type",
    "sha256"
   ],
   "properties": {
    "@id": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "@type": {
     "const": "ManuscriptRef"
    },
    "title": {
     "type": "string"
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
     "type": "string"
    }
   },
   "description": "The manuscript is registered by hash; its text is held only in the gateway's manuscript store"
  },
  "Commitment": {
   "type": "object",
   "required": [
    "@id",
    "statement",
    "kind",
    "entitlement"
   ],
   "properties": {
    "@id": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "statement": {
     "type": "string"
    },
    "locus": {
     "$ref": "#/$defs/Locus"
    },
    "kind": {
     "enum": [
      "avowed",
      "consequential"
     ]
    },
    "via": {
     "type": "string",
     "description": "For consequential commitments: the inference used (e.g. MI6, or 'Prop. 1 and \u00a72.4')"
    },
    "entitlement": {
     "enum": [
      "argued",
      "evidenced",
      "deferred",
      "default",
      "challenged",
      "unentitled"
     ]
    },
    "entitlementBasis": {
     "type": "string"
    }
   }
  },
  "Incompatibility": {
   "type": "object",
   "required": [
    "@id",
    "between",
    "reason"
   ],
   "properties": {
    "@id": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "between": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "reason": {
     "type": "string"
    }
   }
  },
  "Challenge": {
   "type": "object",
   "required": [
    "@id",
    "target",
    "question"
   ],
   "properties": {
    "@id": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "target": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "question": {
     "type": "string"
    }
   }
  },
  "Scoreboard": {
   "type": "object",
   "required": [
    "@id",
    "@type",
    "manuscript",
    "scorekeeper",
    "commitments"
   ],
   "properties": {
    "@id": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "@type": {
     "const": "Scoreboard"
    },
    "manuscript": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "scorekeeper": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "commitments": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Commitment"
     }
    },
    "incompatibilities": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Incompatibility"
     }
    },
    "challenges": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Challenge"
     }
    }
   }
  },
  "ClaimedContribution": {
   "type": "object",
   "required": [
    "@id",
    "statement"
   ],
   "properties": {
    "@id": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "statement": {
     "type": "string"
    },
    "locus": {
     "$ref": "#/$defs/Locus"
    }
   }
  },
  "Finding": {
   "type": "object",
   "required": [
    "@id",
    "locus",
    "problem",
    "severity",
    "status"
   ],
   "properties": {
    "@id": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "dimension": {
     "enum": [
      "ONT",
      "EPI",
      "INF",
      "TEC",
      "PRA"
     ]
    },
    "probeType": {
     "enum": [
      "P-DER",
      "P-ID",
      "P-NUM",
      "P-MEAS",
      "P-INF",
      "P-LIT"
     ]
    },
    "locus": {
     "$ref": "#/$defs/Locus"
    },
    "commitment": {
     "type": "string"
    },
    "problem": {
     "type": "string"
    },
    "severity": {
     "enum": [
      "fatal",
      "damaging",
      "fixable",
      "minor"
     ]
    },
    "repair": {
     "type": "string"
    },
    "status": {
     "enum": [
      "asserted",
      "demonstrated",
      "refuted-by-check",
      "inconclusive"
     ]
    },
    "check": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    }
   }
  },
  "ContributionVerdict": {
   "type": "object",
   "required": [
    "contribution",
    "verdict"
   ],
   "properties": {
    "contribution": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "verdict": {
     "enum": [
      "survives",
      "qualified",
      "fails"
     ]
    },
    "qualifiedForm": {
     "type": "string"
    },
    "restatement": {
     "type": "string"
    }
   }
  },
  "SimulatedReview": {
   "type": "object",
   "required": [
    "@id",
    "@type",
    "perspective",
    "contributions",
    "verdicts",
    "findings",
    "recommendation"
   ],
   "properties": {
    "@id": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "@type": {
     "const": "SimulatedReview"
    },
    "perspective": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "relationToFocal": {
     "enum": [
      "resembling",
      "differing"
     ]
    },
    "contributions": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/ClaimedContribution"
     }
    },
    "verdicts": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/ContributionVerdict"
     }
    },
    "findings": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Finding"
     }
    },
    "rival": {
     "type": "string"
    },
    "discriminatingObservation": {
     "type": "string"
    },
    "mindChangers": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "recommendation": {
     "enum": [
      "accept",
      "minor revision",
      "major revision",
      "reject"
     ]
    },
    "drivers": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "simulated": {
     "const": true
    }
   }
  },
  "Disagreement": {
   "type": "object",
   "required": [
    "between",
    "about",
    "kind"
   ],
   "properties": {
    "between": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
     }
    },
    "about": {
     "type": "string"
    },
    "kind": {
     "enum": [
      "fault-line",
      "resolvable",
      "idiosyncratic"
     ]
    },
    "parameters": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "settleBy": {
     "type": "string"
    }
   }
  },
  "SurvivalRow": {
   "type": "object",
   "required": [
    "contribution",
    "verdicts",
    "score"
   ],
   "properties": {
    "contribution": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "verdicts": {
     "type": "object"
    },
    "score": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "robust": {
     "type": "boolean"
    },
    "lensDependent": {
     "type": "boolean"
    }
   }
  },
  "PanelSynthesis": {
   "type": "object",
   "required": [
    "@id",
    "@type",
    "reviews",
    "survival",
    "disagreements"
   ],
   "properties": {
    "@id": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "@type": {
     "const": "PanelSynthesis"
    },
    "reviews": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
     }
    },
    "survival": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/SurvivalRow"
     }
    },
    "agreements": {
     "type": "array",
     "items": {
      "type": "object"
     }
    },
    "disagreements": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Disagreement"
     }
    },
    "recommendationSpread": {
     "type": "object"
    }
   }
  },
  "CheckSpec": {
   "type": "object",
   "required": [
    "@id",
    "@type",
    "finding",
    "language",
    "code"
   ],
   "properties": {
    "@id": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "@type": {
     "const": "CheckSpec"
    },
    "finding": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "language": {
     "const": "python"
    },
    "code": {
     "type": "string"
    },
    "premises": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Locus"
     }
    }
   }
  },
  "CheckResult": {
   "type": "object",
   "required": [
    "@id",
    "@type",
    "check",
    "ranAt",
    "stdout",
    "verdict"
   ],
   "properties": {
    "@id": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "@type": {
     "const": "CheckResult"
    },
    "check": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "harness": {
     "type": "string"
    },
    "ranAt": {
     "type": "string",
     "format": "date-time"
    },
    "stdout": {
     "type": "string"
    },
    "verdict": {
     "enum": [
      "demonstrated",
      "refuted-by-check",
      "inconclusive"
     ]
    }
   }
  },
  "ConsistencyReport": {
   "type": "object",
   "required": [
    "@id",
    "@type",
    "specification",
    "review",
    "applied"
   ],
   "properties": {
    "@id": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "@type": {
     "const": "ConsistencyReport"
    },
    "specification": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "review": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "applied": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "standard",
       "status"
      ],
      "properties": {
       "standard": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
       },
       "status": {
        "enum": [
         "applied",
         "partial",
         "not-applied"
        ]
       },
       "locus": {
        "type": "string"
       }
      }
     }
    },
    "silentSkips": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
     }
    },
    "undeclared": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "inconsistencies": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "briefAnswered": {
     "type": "string"
    }
   }
  },
  "Actor": {
   "type": "object",
   "required": [
    "kind",
    "name"
   ],
   "properties": {
    "kind": {
     "enum": [
      "human",
      "agent",
      "harness",
      "stand-in",
      "orchestrator"
     ]
    },
    "name": {
     "type": "string"
    },
    "model": {
     "type": "string"
    },
    "gatewayRoute": {
     "type": "string"
    },
    "instructionSetVersion": {
     "type": "string"
    }
   }
  },
  "ProvenanceEvent": {
   "type": "object",
   "required": [
    "@id",
    "@type",
    "timestamp",
    "timestampKind",
    "actor",
    "action",
    "prevHash",
    "hash"
   ],
   "properties": {
    "@id": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "@type": {
     "const": "ProvenanceEvent"
    },
    "timestamp": {
     "type": "string",
     "format": "date-time"
    },
    "timestampKind": {
     "enum": [
      "actual",
      "reconstructed"
     ]
    },
    "actor": {
     "$ref": "#/$defs/Actor"
    },
    "action": {
     "enum": [
      "ingest",
      "seal",
      "elicit",
      "specify",
      "simulate",
      "synthesize",
      "probe",
      "check",
      "consistency-check",
      "draft",
      "accept",
      "reject",
      "modify",
      "include",
      "sign",
      "score",
      "annotate",
      "delete"
     ]
    },
    "inputs": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
     }
    },
    "outputs": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
     }
    },
    "respondsTo": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "rationale": {
     "type": "string"
    },
    "contentHash": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "prevHash": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "hash": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    }
   }
  },
  "ConsentRecord": {
   "type": "object",
   "required": [
    "@id",
    "@type",
    "party",
    "role",
    "scope",
    "grantedAt",
    "instrumentVersion"
   ],
   "properties": {
    "@id": {
     "type": "string",
     "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_.:-]+$"
    },
    "@type": {
     "const": "ConsentRecord"
    },
    "party": {
     "type": "string",
     "description": "Pseudonymous id"
    },
    "role": {
     "enum": [
      "editor",
      "author",
      "reviewer"
     ]
    },
    "scope": {
     "type": "array",
     "items": {
      "enum": [
       "workbench-use",
       "ai-assisted-track",
       "pairing",
       "research-use",
       "blind-evaluation",
       "deidentified-release",
       "base-model-study"
      ]
     }
    },
    "grantedAt": {
     "type": "string",
     "format": "date-time"
    },
    "withdrawnAt": {
     "type": [
      "string",
      "null"
     ],
     "format": "date-time"
    },
    "instrumentVersion": {
     "type": "string"
    }
   }
  }
 },
